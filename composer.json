{
    "name": "scout/laravel",
    "description": "Laravel-native observability instrumentation runtime",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "observability",
        "tracing",
        "apm",
        "opentelemetry"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "larastan/larastan": "^3.0",
        "laravel/horizon": "^5.30",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Obeserva\\Contracts\\": "src/Contracts/",
            "Obeserva\\Core\\": "src/Core/",
            "Obeserva\\Laravel\\": "src/",
            "Obeserva\\ScoutDriver\\": "src/ScoutDriver/",
            "Obeserva\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obeserva\\Contracts\\Tests\\": "tests/Contracts/",
            "Obeserva\\Core\\Tests\\": "tests/Core/",
            "Obeserva\\Laravel\\Tests\\": "tests/Laravel/",
            "Obeserva\\Testing\\Tests\\": "tests/Testing/"
        }
    },
    "suggest": {
        "laravel/horizon": "Required for Horizon worker instrumentation (v0.4.0+).",
        "scoutapp/scout-apm-laravel": "Required for Scout APM export when OBESERVA_DRIVER=scout (v0.5.0+)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obeserva\\Laravel\\ObeservaServiceProvider"
            ],
            "aliases": {
                "Obeserva": "Obeserva\\Laravel\\Facades\\Obeserva"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "audit": {
            "abandoned": "report",
            "ignore-abandoned": {
                "sebastian/code-unit": "Transitive PHPUnit 11 dependency; abandoned with no replacement until upstream updates.",
                "sebastian/code-unit-reverse-lookup": "Transitive phpunit/php-code-coverage dependency; abandoned with no replacement until upstream updates."
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@php scripts/require-coverage-driver.php",
            "phpunit --coverage-clover coverage.xml"
        ],
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test",
        "infection": "infection --threads=4",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "validate:deps": "composer validate --strict",
        "ci": [
            "@test",
            "@analyse",
            "@format:check",
            "@rector:check",
            "@validate:deps"
        ],
        "pre-push": [
            "@test",
            "@test:coverage",
            "@analyse",
            "@format:check",
            "@rector:check",
            "@infection",
            "@validate:deps"
        ]
    }
}
