{
    "name": "obeserva/testing",
    "version": "0.3.0",
    "description": "Testing utilities, fake tracers, and propagation assertions for Obeserva",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "obeserva/contracts": "@dev",
        "obeserva/core": "@dev",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Obeserva\\Testing\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
